<Window x:Class="PCActivityLog.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="640" Width="620" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <DockPanel Margin="12">
        <!-- 底部按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="应用更改（文件夹 / 间隔）" Command="{Binding ApplyCommand}" Padding="10,5" />
            <Button Content="关闭" Click="Close_Click" Padding="14,5" Margin="8,0,0,0" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ======== 外观 ======== -->
                <GroupBox Header="外观" Padding="8" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="主题模式：" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox SelectedIndex="{Binding ThemeModeIndex}" Width="160">
                            <ComboBoxItem Content="跟随系统（浅色 / 深色自动切换）"/>
                            <ComboBoxItem Content="浅色"/>
                            <ComboBoxItem Content="深色"/>
                        </ComboBox>
                    </StackPanel>
                </GroupBox>

                <!-- ======== 文件监视 ======== -->
                <GroupBox Header="文件监视（下载 / 删除 / 重命名）" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox Content="启用文件监视模块" IsChecked="{Binding ModuleFileEnabled}"
                                  FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox Content="记录下载（含来源网址）" IsChecked="{Binding RecordDownloads}" Margin="0,0,20,0" />
                            <CheckBox Content="记录删除" IsChecked="{Binding RecordDeletes}" Margin="0,0,20,0" />
                            <CheckBox Content="记录重命名" IsChecked="{Binding RecordRenames}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="下载落盘判定等待（秒，2-60）：" VerticalAlignment="Center" />
                            <TextBox Text="{Binding SettleSeconds}" Width="60" />
                        </StackPanel>
                        <TextBlock Text="监视的文件夹：" Margin="0,4,0,4" />
                        <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}"
                                 Height="110" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="添加文件夹" Command="{Binding AddFolderCommand}" />
                            <Button Content="删除选中" Command="{Binding RemoveFolderCommand}" />
                            <TextBlock Text="改动后需点下方「应用更改」" Foreground="#94A3B8" FontSize="12"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ======== 软件监视 ======== -->
                <GroupBox Header="软件监视（安装 / 更新 / 卸载）" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox Content="启用软件监视模块" IsChecked="{Binding ModuleAppEnabled}"
                                  FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox Content="记录安装" IsChecked="{Binding RecordInstalls}" Margin="0,0,20,0" />
                            <CheckBox Content="记录更新" IsChecked="{Binding RecordUpdates}" Margin="0,0,20,0" />
                            <CheckBox Content="记录卸载" IsChecked="{Binding RecordUninstalls}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="注册表轮询间隔（秒，10-3600）：" VerticalAlignment="Center" />
                            <TextBox Text="{Binding RegistryPollSeconds}" Width="70" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ======== 系统监视 ======== -->
                <GroupBox Header="系统监视" Padding="8" Margin="0,0,0,10">
                    <CheckBox Content="记录开机 / 关机时间" IsChecked="{Binding ModuleSystemEnabled}" FontWeight="SemiBold" />
                </GroupBox>

                <!-- ======== 浏览器记录 ======== -->
                <GroupBox Header="浏览器记录" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox Content="启用浏览器记录模块" IsChecked="{Binding ModuleBrowserEnabled}"
                                  FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox Content="Chrome" IsChecked="{Binding BrowserChrome}" Margin="0,0,20,0" />
                            <CheckBox Content="Edge" IsChecked="{Binding BrowserEdge}" Margin="0,0,20,0" />
                            <CheckBox Content="Firefox" IsChecked="{Binding BrowserFirefox}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="读取间隔（分钟，1-120）：" VerticalAlignment="Center" />
                            <TextBox Text="{Binding BrowserPollMinutes}" Width="60" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="浏览记录保留天数（0=永久）：" VerticalAlignment="Center" />
                            <TextBox Text="{Binding BrowserRetentionDays}" Width="60" />
                            <TextBlock Text="（默认 90 天，其他事件默认永久）" Foreground="#94A3B8" FontSize="12"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ======== 微信/QQ 文件监视 ======== -->
                <GroupBox Header="微信/QQ 文件监视" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox Content="启用微信/QQ 文件监视模块" IsChecked="{Binding ModuleImEnabled}"
                                  FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox Content="微信收到的文件" IsChecked="{Binding ImWechat}" Margin="0,0,20,0" />
                            <CheckBox Content="QQ 收到的文件" IsChecked="{Binding ImQq}" />
                        </StackPanel>
                        <TextBlock Text="自动识别默认存储位置（文档下的 xwechat_files / WeChat Files / Tencent Files）；文件被微信/QQ清理后，记录会自动标注「已清理」。"
                                   Foreground="#94A3B8" FontSize="11.5" TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>

                <!-- ======== 数据保留 ======== -->
                <GroupBox Header="数据保留（其他事件）" Padding="8" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="下载/安装等非浏览事件保留天数（0=永久）：" VerticalAlignment="Center" />
                        <TextBox Text="{Binding OtherRetentionDays}" Width="60" />
                    </StackPanel>
                </GroupBox>

                <!-- ======== 通知 ======== -->
                <GroupBox Header="气泡通知" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox Content="启用气泡通知（10 秒节流）" IsChecked="{Binding NotificationsEnabled}"
                                  FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="下载" IsChecked="{Binding NotifyDownloads}" Margin="0,0,20,0" />
                            <CheckBox Content="应用" IsChecked="{Binding NotifyApp}" Margin="0,0,20,0" />
                            <CheckBox Content="系统" IsChecked="{Binding NotifySystem}" Margin="0,0,20,0" />
                            <CheckBox Content="浏览（易刷屏，慎开）" IsChecked="{Binding NotifyBrowse}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ======== 行为 ======== -->
                <GroupBox Header="通用行为" Padding="8">
                    <StackPanel>
                        <CheckBox Content="点窗口关闭按钮时最小化到托盘（取消勾选则直接退出）"
                                  IsChecked="{Binding MinimizeToTrayOnClose}" Margin="0,0,0,6" />
                        <CheckBox Content="开机自动启动（后台静默运行）" IsChecked="{Binding StartWithWindows}" />
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
