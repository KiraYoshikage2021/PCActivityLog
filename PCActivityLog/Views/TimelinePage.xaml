<Page
    x:Class="PCActivityLog.Views.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:vm="using:PCActivityLog.ViewModels"
    NavigationCacheMode="Enabled"
    Background="{ThemeResource PageBgBrush}">

    <Grid Padding="16,16,16,8" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 筛选工具栏卡片 ============ -->
        <Border Grid.Row="0" Background="{ThemeResource CardBgBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="12,9">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" Width="118"
                          ItemsSource="{x:Bind Vm.Groups}"
                          SelectedItem="{x:Bind Vm.SelectedGroup, Mode=TwoWay}"
                          DisplayMemberPath="Name"/>

                <!-- 时间范围快捷选择：默认"最近 3 天"，也可选其他范围或自定义 -->
                <ComboBox Grid.Column="1" Width="112" Margin="0,0,8,0"
                          ItemsSource="{x:Bind Vm.DateRanges}"
                          SelectedItem="{x:Bind Vm.SelectedRange, Mode=TwoWay}"
                          DisplayMemberPath="Name"/>

                <TextBox Grid.Column="2" Width="200" PlaceholderText="搜索名称 / 路径 / 备注"
                         Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="3" Text="从" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextSecondaryBrush}"/>
                <DatePicker Grid.Column="4" Width="130" SelectedDate="{x:Bind Vm.DateFrom, Mode=TwoWay}"/>
                <TextBlock Grid.Column="5" Text="到" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextSecondaryBrush}"/>
                <DatePicker Grid.Column="6" Width="130" SelectedDate="{x:Bind Vm.DateTo, Mode=TwoWay}"/>

                <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="8">
                    <Button Content="查询" Command="{x:Bind Vm.RefreshCommand}" Style="{StaticResource AccentButtonStyle}"/>
                    <Button Content="＋ 添加记录" Click="AddEvent_Click"/>
                    <Button Content="导出 CSV" Click="ExportCsv_Click"/>
                    <Button Content="导出 JSON" Click="ExportJson_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 事件列表卡片 ============ -->
        <Border Grid.Row="1" Background="{ThemeResource CardBgBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="2">
            <controls:DataGrid x:Name="Grid"
                               ItemsSource="{x:Bind Vm.Items}"
                               AutoGenerateColumns="False"
                               IsReadOnly="True"
                               SelectionMode="Single"
                               CanUserResizeColumns="True"
                               CanUserSortColumns="False"
                               GridLinesVisibility="None"
                               HeadersVisibility="Column"
                               RowHeight="38"
                               SelectedItem="{x:Bind Vm.SelectedItem, Mode=TwoWay}"
                               DoubleTapped="Grid_DoubleTapped"
                               RightTapped="Grid_RightTapped"
                               Background="Transparent"
                               BorderThickness="0">
                <controls:DataGrid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="打开文件位置" Click="OpenLocation_Click"/>
                        <MenuFlyoutItem Text="跳到来源安装包" Click="JumpLinked_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="复制名称" Click="CopyName_Click"/>
                    </MenuFlyout>
                </controls:DataGrid.ContextFlyout>
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="时间" Binding="{Binding TimeDisplay}" Width="150" MinWidth="110"
                                                />
                    <controls:DataGridTemplateColumn Header="类型" Width="84" MinWidth="70">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- 小圆角 tag + 同色系细描边。
                                     注意：DataGrid 行容器是回收复用的，模板内必须用 {Binding}
                                     而非 x:Bind（OneTime 不随回收更新 → 脏数据 + 回收退化卡顿） -->
                                <Border Background="{Binding TypeBadgeBrush}" CornerRadius="4"
                                        BorderBrush="{Binding TypeBrush}" BorderThickness="1"
                                        Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TypeDisplay}" Foreground="{Binding TypeBrush}"
                                               FontSize="11.5" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    <controls:DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="120"/>
                    <controls:DataGridTemplateColumn Header="大小 / 版本" Width="180" MinWidth="100">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding LocalStatusDisplay}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding LocalStatusBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LinkedHint}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    <controls:DataGridTextColumn Header="路径" Binding="{Binding Location}" Width="320" MinWidth="120"
                                                />
                    <controls:DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="140" MinWidth="80"
                                                />
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Border>

        <!-- ============ 状态栏 ============ -->
        <Grid Grid.Row="2" Padding="4,4,4,0">
            <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" FontSize="12"
                       Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            <Button Content="加载更多 ↓" HorizontalAlignment="Right"
                    Visibility="{x:Bind Vm.HasMore, Mode=OneWay}"
                    Command="{x:Bind Vm.LoadMoreCommand}"/>
        </Grid>
    </Grid>
</Page>
