<Page
    x:Class="PCActivityLog.Views.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled"
    Background="{ThemeResource PageBgBrush}">

    <Grid Padding="16,16,16,8" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 筛选工具栏卡片 ============ -->
        <Border Grid.Row="0" Background="{ThemeResource CardBgBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="12,9">
            <!-- 横向滚动兜底：窗口极窄时出滚动条而非裁剪控件 -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <!-- 两行各自独立 Grid（列宽互不干扰）：宽窗口全部在 FilterRow 单行；
                     窄窗口由代码后置把日期区间与按钮组搬进 DateRow（SettingsPage 同款响应式模式） -->
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="FilterRow" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 分组下拉：自适应宽度（下限防跳动、上限防长分组名撑爆工具栏），超宽省略号 -->
                        <ComboBox x:Name="GroupBox" Grid.Column="0" Height="36" MinWidth="118" MaxWidth="180"
                                  ItemsSource="{x:Bind Vm.Groups}"
                                  SelectedItem="{x:Bind Vm.SelectedGroup, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- 时间范围快捷选择：去掉固定宽度（原 112 放不下「最近 90 天」被截断），用 MinWidth 防选中项切换时跳动 -->
                        <ComboBox Grid.Column="1" Height="36" MinWidth="128" Margin="0,0,8,0"
                                  ItemsSource="{x:Bind Vm.DateRanges}"
                                  SelectedItem="{x:Bind Vm.SelectedRange, Mode=TwoWay}"
                                  DisplayMemberPath="Name"/>

                        <TextBox Grid.Column="2" Height="36" Width="200" PlaceholderText="搜索名称 / 路径 / 备注"
                                 Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock x:Name="DateFromLabel" Grid.Column="3" Text="从" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <!-- 日期选择：日期按钮 + CalendarView 日历下拉。原 WinUI DatePicker 的可见面与
                             弹出层模板存在多处写死的宽度/对齐行为且无法用资源覆盖修正，整体弃用；
                             选中即写入 Vm.DateFrom/DateTo（触发自动刷新）并收起日历 -->
                        <DropDownButton x:Name="DateFromButton" Grid.Column="4" Height="36" MinWidth="124"
                                        ToolTipService.ToolTip="选择开始日期">
                            <DropDownButton.Flyout>
                                <Flyout Placement="Bottom">
                                    <CalendarView/>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <TextBlock x:Name="DateToLabel" Grid.Column="5" Text="到" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <DropDownButton x:Name="DateToButton" Grid.Column="6" Height="36" MinWidth="124"
                                        ToolTipService.ToolTip="选择结束日期">
                            <DropDownButton.Flyout>
                                <Flyout Placement="Bottom">
                                    <CalendarView/>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                    <!-- 四个按钮统一高度 36（工具栏整行控件同高）；
                          WinUI 按钮默认按内容算高且 32 对中文字形偏挤（文字贴底被裁） -->
                    <StackPanel x:Name="ActionButtons" Grid.Column="8" Orientation="Horizontal" Spacing="8">
                        <Button Content="查询" Height="36" Command="{x:Bind Vm.RefreshCommand}" Style="{StaticResource AccentButtonStyle}"/>
                        <Button Content="＋ 添加记录" Height="36" Click="AddEvent_Click"/>
                        <Button Height="36" ToolTipService.ToolTip="导出当前筛选结果">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="导出" VerticalAlignment="Center"/>
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE70D;" FontSize="12"/>
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="导出 CSV" Click="ExportCsv_Click"/>
                                    <MenuFlyoutItem Text="导出 JSON" Click="ExportJson_Click"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <!-- 齿轮按钮：与其他按钮同高；图标按钮自然略窄 -->
                        <Button Click="OpenSettings_Click" Height="36" ToolTipService.ToolTip="设置">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;" FontSize="16"/>
                        </Button>
                    </StackPanel>
                    </Grid>

                    <!-- 窄窗口第二行（默认折叠，代码后置按窗口宽度启用） -->
                    <Grid x:Name="DateRow" Grid.Row="1" ColumnSpacing="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ============ 事件列表卡片 ============ -->
        <Border Grid.Row="1" Background="{ThemeResource CardBgBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 静态表头（不可交互，纯视觉分栏） -->
                <Grid Grid.Row="0" Background="{ThemeResource HeaderBgBrush}"
                      Padding="10,0" Height="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="时间" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="类型" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="名称" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="大小 / 版本" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="路径" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="备注" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>

                <!-- 分隔线 -->
                <Border Grid.Row="0" Height="1" Background="{ThemeResource HeaderBorderBrush}"
                        VerticalAlignment="Bottom" Margin="0,37,0,0"/>

                <!-- 事件列表（原生 ListView，虚拟化性能最优） -->
                <ListView x:Name="EventList" Grid.Row="1"
                          ItemsSource="{x:Bind Vm.Items}"
                          SelectionMode="Single"
                          IsItemClickEnabled="False"
                          DoubleTapped="EventList_DoubleTapped"
                          RightTapped="EventList_RightTapped"
                          SelectionChanged="EventList_SelectionChanged"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="打开文件位置" Click="OpenLocation_Click"/>
                            <MenuFlyoutItem Text="跳到来源安装包" Click="JumpLinked_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="复制名称" Click="CopyName_Click"/>
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="38"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10,0" MinHeight="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}" FontSize="12.5"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                <!-- 类型徽章：小圆角 tag + 同色系细描边 -->
                                <Border Grid.Column="1" Background="{Binding TypeBadgeBrush}" CornerRadius="4"
                                        BorderBrush="{Binding TypeBrush}" BorderThickness="1"
                                        Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TypeDisplay}" Foreground="{Binding TypeBrush}"
                                               FontSize="11.5" FontWeight="SemiBold"/>
                                </Border>

                                <TextBlock Grid.Column="2" Text="{Binding Name}"
                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LocalStatusDisplay}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding LocalStatusBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LinkedHint}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Column="4" Text="{Binding Location}" FontSize="12"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="5" Text="{Binding Note}" FontSize="12"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- ============ 状态栏 ============ -->
        <Grid Grid.Row="2" Padding="4,4,4,0">
            <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" FontSize="12"
                       Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            <Button Content="加载更多 ↓" HorizontalAlignment="Right"
                    Visibility="{x:Bind Vm.HasMore, Mode=OneWay}"
                    Command="{x:Bind Vm.LoadMoreCommand}"/>
        </Grid>
    </Grid>
</Page>
