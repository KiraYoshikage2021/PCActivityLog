<Window x:Class="PCActivityLog.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:PCActivityLog.Views.Controls"
        Title="电脑日志记录" Height="700" Width="1160" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 各列的文字微样式（须在使用之前声明，StaticResource 只向后查找） -->
        <Style x:Key="TimeCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="NameCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Name}"/>
        </Style>
        <Style x:Key="LocationCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Location}"/>
        </Style>
        <Style x:Key="NoteCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Note}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0" Margin="12,12,12,0" SelectionChanged="Tabs_SelectionChanged">

            <!-- ============ 时间线页 ============ -->
            <TabItem Header="时间线">
                <DockPanel Margin="0,12,0,0">

                    <!-- 筛选工具栏卡片 -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}"
                            Padding="12,9" Margin="0,0,0,10">
                        <WrapPanel>
                            <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                                      Width="104" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="240" Margin="0,0,8,0" Padding="9,6"
                                     Tag="🔍 搜索名称 / 路径 / 网址 / 备注" VerticalAlignment="Center"/>
                            <TextBlock Text="从" VerticalAlignment="Center" Margin="4,0,5,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <DatePicker SelectedDate="{Binding DateFrom}" Width="122" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="到" VerticalAlignment="Center" Margin="3,0,5,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <DatePicker SelectedDate="{Binding DateTo}" Width="122" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Button Content="查询" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}"/>
                            <Button Content="＋ 添加记录" Command="{Binding AddEventCommand}"/>
                            <Button Content="设置" Click="OpenSettings_Click"/>
                            <Button Content="导出 CSV" Command="{Binding ExportCsvCommand}"/>
                            <Button Content="导出 JSON" Command="{Binding ExportJsonCommand}" Margin="0"/>
                        </WrapPanel>
                    </Border>

                    <!-- 事件列表卡片（不放任何位图效果，保证滚动性能） -->
                    <Border Style="{StaticResource CardStyle}" ClipToBounds="True">
                        <DataGrid x:Name="Grid" ItemsSource="{Binding Items}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  MouseDoubleClick="Grid_MouseDoubleClick"
                                  Background="Transparent" BorderThickness="0"
                                  CanUserResizeRows="False" RowHeaderWidth="0">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="打开文件位置 / 网址"
                                              Command="{Binding OpenLocationCommand}"
                                              CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    <MenuItem Header="编辑备注"
                                              Command="{Binding EditNoteCommand}"
                                              CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    <MenuItem Header="跳到来源安装包"
                                              Command="{Binding JumpLinkedCommand}"
                                              CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    <Separator/>
                                    <MenuItem Header="复制名称" Click="CopyName_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding TimeDisplay}" Width="146"
                                                    ElementStyle="{StaticResource TimeCell}"/>
                                <DataGridTemplateColumn Header="类型" Width="76">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding TypeBadgeBrush}" CornerRadius="999"
                                                    Padding="10,3" HorizontalAlignment="Left" Margin="2,0"
                                                    SnapsToDevicePixels="True">
                                                <TextBlock Text="{Binding TypeDisplay}" Foreground="{Binding TypeBrush}"
                                                           FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"
                                                    ElementStyle="{StaticResource NameCell}"/>
                                <DataGridTemplateColumn Header="大小 / 版本" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Detail}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding LinkedHint}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           ToolTip="此软件由该下载的安装包安装，双击行可跳转"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="路径 / 网址" Binding="{Binding Location}" Width="300"
                                                    ElementStyle="{StaticResource LocationCell}"/>
                                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="130"
                                                    ElementStyle="{StaticResource NoteCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- ============ 统计页 ============ -->
            <TabItem Header="统计">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel DataContext="{Binding Stats}" Margin="0,0,4,0">

                        <!-- 汇总卡片 -->
                        <WrapPanel Margin="0,0,0,14">
                            <Border Style="{StaticResource CardStyle}" Width="200" Padding="16,14" Margin="0,0,12,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📥" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="本月下载" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding MonthDownloads}" FontSize="26" FontWeight="Bold"
                                                   Foreground="{DynamicResource StatBlueBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Width="220" Padding="16,14" Margin="0,0,12,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="本月下载总量" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding MonthDownloadBytesText}" FontSize="26" FontWeight="Bold"
                                                   Foreground="{DynamicResource StatBlueBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Width="180" Padding="16,14" Margin="0,0,12,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="本月安装" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding MonthInstalls}" FontSize="26" FontWeight="Bold"
                                                   Foreground="{DynamicResource StatGreenBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Width="180" Padding="16,14" Margin="0,0,12,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="本月浏览" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding MonthBrowses}" FontSize="26" FontWeight="Bold"
                                                   Foreground="{DynamicResource StatCyanBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Width="200" Padding="16,14" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔢" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="累计事件总数" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding TotalEvents}" FontSize="26" FontWeight="Bold"
                                                   Foreground="{DynamicResource StatSlateBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- 图表卡片 -->
                        <Border Style="{StaticResource CardStyle}" Padding="16,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="每月趋势" FontSize="14" FontWeight="SemiBold" DockPanel.Dock="Left"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <!-- 图例（胶囊） -->
                                    <ItemsControl ItemsSource="{Binding Legend}" HorizontalAlignment="Right">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="999" Padding="10,3" Margin="6,0,0,0"
                                                        BorderThickness="1" BorderBrush="{Binding Color}">
                                                    <TextBlock Text="{Binding Legend}" FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                                <ctl:BarChart Columns="{Binding Columns}" Height="270"/>
                                <TextBlock Text="统计口径：最近 12 个月，按事件发生月份分组。"
                                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5" Margin="2,8,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 状态栏 -->
        <Border Grid.Row="1" Padding="12,6,12,10" Background="Transparent">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="加载更多 ↓"
                        Command="{Binding LoadMoreCommand}" Padding="10,3"
                        Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
