<Page
    x:Class="PCActivityLog.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled"
    Background="{ThemeResource PageBgBrush}">

    <Page.Resources>
        <!-- 设置卡片统一外观 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}"/>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
        <!-- 两列独立堆叠：各自卡片高度互不影响（避免 Grid 共享行高导致卡片被拉伸） -->
        <Grid x:Name="SettingsRoot" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeft" Width="*"/>
                <ColumnDefinition x:Name="ColRight" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== 左列 ==================== -->
            <StackPanel x:Name="LeftColumn" Grid.Column="0" Spacing="12">

                <!-- 外观 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="外观" Style="{StaticResource CardTitle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="主题模式：" Style="{StaticResource LabelText}"/>
                            <ComboBox x:Name="ThemeBox" Width="200" SelectionChanged="ThemeBox_SelectionChanged">
                                <ComboBoxItem Content="跟随系统（浅色 / 深色自动切换）"/>
                                <ComboBoxItem Content="浅色"/>
                                <ComboBoxItem Content="深色"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 软件监视 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="软件监视（安装 / 更新 / 卸载）" Style="{StaticResource CardTitle}"/>
                        <ToggleSwitch x:Name="AppModuleSwitch" Header="启用软件监视模块" OnContent="开" OffContent="关"
                                      Toggled="AppModule_Toggled"/>
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <CheckBox x:Name="RecordInstalls" Content="记录安装" Click="SubSwitch_Click"/>
                            <CheckBox x:Name="RecordUpdates" Content="记录更新" Click="SubSwitch_Click"/>
                            <CheckBox x:Name="RecordUninstalls" Content="记录卸载" Click="SubSwitch_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="注册表轮询间隔（秒，10-3600）：" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="RegistryPollSeconds" Width="90" VerticalAlignment="Center" LostFocus="Interval_LostFocus"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 微信/QQ 文件监视 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="微信/QQ 文件监视" Style="{StaticResource CardTitle}"/>
                        <ToggleSwitch x:Name="ImModuleSwitch" Header="启用微信/QQ 文件监视模块" OnContent="开" OffContent="关"
                                      Toggled="ImModule_Toggled"/>
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <CheckBox x:Name="ImWechat" Content="微信收到的文件" Click="SubSwitch_Click"/>
                            <CheckBox x:Name="ImQq" Content="QQ 收到的文件" Click="SubSwitch_Click"/>
                        </StackPanel>
                        <TextBlock Text="自动识别默认存储位置（文档下的 xwechat_files / WeChat Files / Tencent Files）。"
                                   Style="{StaticResource HintText}"/>

                        <!-- 自定义存储路径：微信/QQ 可修改默认位置，这里让用户手动补充 -->
                        <TextBlock Text="自定义监视路径（微信/QQ 改了默认存放位置时在此添加）："
                                   Style="{StaticResource HintText}" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <ListView x:Name="ImFolderList" Height="90" SelectionMode="Single"
                                  HorizontalAlignment="Stretch"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="添加路径" Click="AddImFolder_Click"/>
                            <Button Content="删除选中" Click="RemoveImFolder_Click"/>
                            <TextBlock Text="改动立即生效" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextTertiaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="文件被清理后记录会自动标注「已清理」。"
                                   Style="{StaticResource HintText}"/>
                    </StackPanel>
                </Border>

                <!-- 通用行为 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="通用行为" Style="{StaticResource CardTitle}"/>
                        <ToggleSwitch x:Name="MinimizeToTray" Header="点窗口关闭按钮时最小化到托盘" OnContent="是" OffContent="否"
                                      Toggled="Minimize_Toggled"/>
                        <ToggleSwitch x:Name="StartWithWindows" Header="开机自动启动（后台静默运行）" OnContent="开" OffContent="关"
                                      Toggled="AutoStart_Toggled"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== 右列 ==================== -->
            <StackPanel x:Name="RightColumn" Grid.Column="1" Spacing="12">

                <!-- 文件监视 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="文件监视（下载 / 删除 / 重命名）" Style="{StaticResource CardTitle}"/>
                        <ToggleSwitch x:Name="FileModuleSwitch" Header="启用文件监视模块" OnContent="开" OffContent="关"
                                      Toggled="FileModule_Toggled"/>
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <CheckBox x:Name="RecordDownloads" Content="记录下载（含来源网址）" Click="SubSwitch_Click"/>
                            <CheckBox x:Name="RecordDeletes" Content="记录删除" Click="SubSwitch_Click"/>
                            <CheckBox x:Name="RecordRenames" Content="记录重命名" Click="SubSwitch_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="下载落盘判定等待（秒，2-60）：" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="SettleSeconds" Width="90" VerticalAlignment="Center" LostFocus="Interval_LostFocus"/>
                        </StackPanel>
                        <TextBlock Text="监视的文件夹：" Style="{StaticResource LabelText}"/>
                        <ListView x:Name="FolderList" Height="110" SelectionMode="Single"
                                  HorizontalAlignment="Stretch"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="添加文件夹" Click="AddFolder_Click"/>
                            <Button Content="删除选中" Click="RemoveFolder_Click"/>
                            <TextBlock x:Name="HintText" Text="改动立即生效" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 系统监视 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="系统监视" Style="{StaticResource CardTitle}"/>
                        <ToggleSwitch x:Name="SystemModuleSwitch" Header="记录开机 / 关机 / 重启 / 睡眠 / 唤醒" OnContent="开" OffContent="关"
                                      Toggled="SystemModule_Toggled"/>
                    </StackPanel>
                </Border>

                <!-- 气泡通知 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="气泡通知" Style="{StaticResource CardTitle}"/>
                        <ToggleSwitch x:Name="NotificationsEnabled" Header="启用气泡通知（10 秒节流）" OnContent="开" OffContent="关"
                                      Toggled="Notify_Toggled"/>
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <CheckBox x:Name="NotifyDownloads" Content="下载" Click="SubSwitch_Click"/>
                            <CheckBox x:Name="NotifyApp" Content="应用" Click="SubSwitch_Click"/>
                            <CheckBox x:Name="NotifySystem" Content="系统" Click="SubSwitch_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
