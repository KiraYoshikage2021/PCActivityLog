<Page
    x:Class="PCActivityLog.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:PCActivityLog.Views.Controls"
    NavigationCacheMode="Enabled"
    Background="{ThemeResource PageBgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <!-- 铺满可用宽度（不再限宽居中），宽屏下卡片和图表充分展开 -->
        <StackPanel Spacing="14" HorizontalAlignment="Stretch">


            <!-- 汇总卡片（手写，避免 DataTemplate 里的复杂绑定） -->
            <Grid ColumnSpacing="12" x:Name="SummaryGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource CardBgBrush}" BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16,14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="📥" FontSize="26" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="本月下载" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind Vm.MonthDownloads, Mode=OneWay}" FontSize="26" FontWeight="Bold"
                                       Foreground="{ThemeResource StatBlueBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource CardBgBrush}" BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16,14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="💾" FontSize="26" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="本月下载总量" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind Vm.MonthDownloadBytesText, Mode=OneWay}" FontSize="26" FontWeight="Bold"
                                       Foreground="{ThemeResource StatBlueBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{ThemeResource CardBgBrush}" BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16,14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="📦" FontSize="26" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="本月安装" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind Vm.MonthInstalls, Mode=OneWay}" FontSize="26" FontWeight="Bold"
                                       Foreground="{ThemeResource StatGreenBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{ThemeResource CardBgBrush}" BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16,14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="🔢" FontSize="26" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="累计事件总数" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind Vm.TotalEvents, Mode=OneWay}" FontSize="26" FontWeight="Bold"
                                       Foreground="{ThemeResource StatSlateBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ 图表卡片 ============ -->
            <Border Background="{ThemeResource CardBgBrush}" BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16,12">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="每月趋势" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <ItemsControl ItemsSource="{x:Bind Vm.Legend}" HorizontalAlignment="Right">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 图例：彩色圆点 + 文字（不再用椭圆描边胶囊） -->
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Legend}" FontSize="11.5"
                                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <ctl:BarChart x:Name="Chart" Columns="{x:Bind Vm.Columns}" Height="270"/>
                    <TextBlock Text="统计口径：最近 12 个月，按事件发生月份分组。"
                               FontSize="11.5" Foreground="{ThemeResource TextTertiaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
