<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ============================================================
         浅色主题配色（与 Dark.xaml 键名完全一致，可整体热切换）
         所有画刷 Freeze 冻结：渲染开销与静态画刷完全相同（性能规范第 3 条）
         ============================================================ -->

    <!-- 页面与卡片 -->
    <SolidColorBrush x:Key="PageBgBrush"      Color="#F1F5F9" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardBgBrush"      Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardBorderBrush"  Color="#E2E8F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="SoftBorderBrush"  Color="#EEF2F6" po:Freeze="True"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#0F172A" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextTertiaryBrush"  Color="#94A3B8" po:Freeze="True"/>

    <!-- 主色 -->
    <SolidColorBrush x:Key="AccentBrush"     Color="#2563EB" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DBEAFE" po:Freeze="True"/>

    <!-- 表格 -->
    <SolidColorBrush x:Key="HoverBrush"      Color="#EFF4FB" po:Freeze="True"/>
    <SolidColorBrush x:Key="ZebraBrush"      Color="#F4F7FB" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderBgBrush"   Color="#F8FAFC" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#E8EDF3" po:Freeze="True"/>

    <!-- 输入控件 -->
    <SolidColorBrush x:Key="InputBgBrush"     Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#CBD5E1" po:Freeze="True"/>

    <!-- 杂项 -->
    <SolidColorBrush x:Key="TooltipBgBrush"   Color="#1E293B" po:Freeze="True"/>
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#F1F5F9" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C6D0DC" po:Freeze="True"/>

    <!-- 图表 -->
    <SolidColorBrush x:Key="ChartTextBrush" Color="#94A3B8" po:Freeze="True"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#E2E8F0" po:Freeze="True"/>

    <!-- 统计卡片数值色 -->
    <SolidColorBrush x:Key="StatBlueBrush"  Color="#2563EB" po:Freeze="True"/>
    <SolidColorBrush x:Key="StatGreenBrush" Color="#16A34A" po:Freeze="True"/>
    <SolidColorBrush x:Key="StatCyanBrush"  Color="#0891B2" po:Freeze="True"/>
    <SolidColorBrush x:Key="StatSlateBrush" Color="#475569" po:Freeze="True"/>

    <!-- 图表四分类色（柱状图与图例共用） -->
    <SolidColorBrush x:Key="DownloadBrush" Color="#2563EB" po:Freeze="True"/>
    <SolidColorBrush x:Key="AppBrush"      Color="#16A34A" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrowseBrush"   Color="#0891B2" po:Freeze="True"/>
    <SolidColorBrush x:Key="OtherBrush"    Color="#CBD5E1" po:Freeze="True"/>
</ResourceDictionary>
