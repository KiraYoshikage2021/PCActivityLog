<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ============================================================
         深色主题配色（石板蓝系，键名与 Light.xaml 完全一致）
         所有画刷 Freeze 冻结（性能规范第 3 条）
         ============================================================ -->

    <!-- 页面与卡片 -->
    <SolidColorBrush x:Key="PageBgBrush"      Color="#0F172A" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardBgBrush"      Color="#1E293B" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardBorderBrush"  Color="#334155" po:Freeze="True"/>
    <SolidColorBrush x:Key="SoftBorderBrush"  Color="#293749" po:Freeze="True"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#E2E8F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextTertiaryBrush"  Color="#64748B" po:Freeze="True"/>

    <!-- 主色（深色下提亮一档保证对比度） -->
    <SolidColorBrush x:Key="AccentBrush"      Color="#3B82F6" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentSoftBrush"  Color="#1E3A5F" po:Freeze="True"/>

    <!-- 表格 -->
    <SolidColorBrush x:Key="HoverBrush"      Color="#24334D" po:Freeze="True"/>
    <SolidColorBrush x:Key="ZebraBrush"      Color="#223046" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderBgBrush"   Color="#223046" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#2E3D55" po:Freeze="True"/>

    <!-- 输入控件 -->
    <SolidColorBrush x:Key="InputBgBrush"     Color="#1A2537" po:Freeze="True"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3B4A5F" po:Freeze="True"/>

    <!-- 杂项 -->
    <SolidColorBrush x:Key="TooltipBgBrush"   Color="#E2E8F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#0F172A" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#5B6B82" po:Freeze="True"/>

    <!-- 图表 -->
    <SolidColorBrush x:Key="ChartTextBrush" Color="#94A3B8" po:Freeze="True"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#334155" po:Freeze="True"/>

    <!-- 统计卡片数值色 -->
    <SolidColorBrush x:Key="StatBlueBrush"  Color="#60A5FA" po:Freeze="True"/>
    <SolidColorBrush x:Key="StatGreenBrush" Color="#4ADE80" po:Freeze="True"/>
    <SolidColorBrush x:Key="StatCyanBrush"  Color="#22D3EE" po:Freeze="True"/>
    <SolidColorBrush x:Key="StatSlateBrush" Color="#94A3B8" po:Freeze="True"/>

    <!-- 图表四分类色 -->
    <SolidColorBrush x:Key="DownloadBrush" Color="#60A5FA" po:Freeze="True"/>
    <SolidColorBrush x:Key="AppBrush"      Color="#4ADE80" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrowseBrush"   Color="#22D3EE" po:Freeze="True"/>
    <SolidColorBrush x:Key="OtherBrush"    Color="#64748B" po:Freeze="True"/>
</ResourceDictionary>
