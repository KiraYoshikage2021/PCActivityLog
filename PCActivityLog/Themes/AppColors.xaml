<!-- 应用主题色板：浅色/深色两套，键名一致，由 RequestedTheme 自动切换 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- ============ 浅色 ============ -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PageBgBrush" Color="#F1F5F9"/>
            <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>
            <SolidColorBrush x:Key="SoftBorderBrush" Color="#EEF2F6"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#94A3B8"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#DBEAFE"/>
            <SolidColorBrush x:Key="HoverBrush" Color="#EFF4FB"/>
            <SolidColorBrush x:Key="ZebraBrush" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="HeaderBgBrush" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="HeaderBorderBrush" Color="#E8EDF3"/>
            <SolidColorBrush x:Key="DownloadBrush" Color="#2563EB"/>
            <SolidColorBrush x:Key="AppBrush" Color="#16A34A"/>
            <SolidColorBrush x:Key="BrowseBrush" Color="#0891B2"/>
            <SolidColorBrush x:Key="OtherBrush" Color="#CBD5E1"/>
            <SolidColorBrush x:Key="StatBlueBrush" Color="#2563EB"/>
            <SolidColorBrush x:Key="StatGreenBrush" Color="#16A34A"/>
            <SolidColorBrush x:Key="StatCyanBrush" Color="#0891B2"/>
            <SolidColorBrush x:Key="StatSlateBrush" Color="#475569"/>
            <SolidColorBrush x:Key="ChartTextBrush" Color="#94A3B8"/>
        </ResourceDictionary>

        <!-- ============ 深色 ============ -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PageBgBrush" Color="#0F172A"/>
            <SolidColorBrush x:Key="CardBgBrush" Color="#1E293B"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#334155"/>
            <SolidColorBrush x:Key="SoftBorderBrush" Color="#293749"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E2E8F0"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#64748B"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E3A5F"/>
            <SolidColorBrush x:Key="HoverBrush" Color="#24334D"/>
            <SolidColorBrush x:Key="ZebraBrush" Color="#223046"/>
            <SolidColorBrush x:Key="HeaderBgBrush" Color="#223046"/>
            <SolidColorBrush x:Key="HeaderBorderBrush" Color="#2E3D55"/>
            <SolidColorBrush x:Key="DownloadBrush" Color="#60A5FA"/>
            <SolidColorBrush x:Key="AppBrush" Color="#4ADE80"/>
            <SolidColorBrush x:Key="BrowseBrush" Color="#22D3EE"/>
            <SolidColorBrush x:Key="OtherBrush" Color="#64748B"/>
            <SolidColorBrush x:Key="StatBlueBrush" Color="#60A5FA"/>
            <SolidColorBrush x:Key="StatGreenBrush" Color="#4ADE80"/>
            <SolidColorBrush x:Key="StatCyanBrush" Color="#22D3EE"/>
            <SolidColorBrush x:Key="StatSlateBrush" Color="#94A3B8"/>
            <SolidColorBrush x:Key="ChartTextBrush" Color="#94A3B8"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
