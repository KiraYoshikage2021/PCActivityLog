<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PCActivityLog</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>2.8.0</Version>
    <AssemblyName>PCActivityLog</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251003001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1721" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
  </ItemGroup>
  <!-- app.ico 必须随输出复制到根目录：ApplicationIcon 只嵌入 exe，AppWindow.SetIcon 需要文件路径 -->
  <ItemGroup>
    <Content Include="Assets\app.ico" Link="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- WinUI3 dotnet publish 缺陷：XAML 产物(.xbf/.pri) 与 app.ico 不随发布复制 -->
  <Target Name="CopyXamlArtifactsOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <XamlArtifacts Include="$(TargetDir)*.xbf;$(TargetDir)*.pri" />
      <IconArtifact Include="$(TargetDir)app.ico" Condition="Exists('$(TargetDir)app.ico')" />
    </ItemGroup>
    <Copy SourceFiles="@(XamlArtifacts)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(IconArtifact)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
  </Target>
  <!-- 发布校验：上面的 workaround 必须真的把 XAML 产物送进发布目录，否则发布版启动即崩
       且用户只会在运行时看到无声失败。上游 SDK 修复该缺陷后，CopyXamlArtifactsOnPublish
       自然变空操作，本校验仍然兜底——把"静默的脆弱点"变成"构建期显式报错"。 -->
  <Target Name="VerifyPublishArtifacts" AfterTargets="CopyXamlArtifactsOnPublish">
    <ItemGroup>
      <_PublishedXbf Include="$(PublishDir)*.xbf" />
      <_PublishedPri Include="$(PublishDir)*.pri" />
    </ItemGroup>
    <Error Condition="'@(_PublishedXbf)' == ''" Text="发布目录缺少 .xbf（XAML 编译产物），发布版会启动即崩；请检查 CopyXamlArtifactsOnPublish target 是否生效。" />
    <Error Condition="'@(_PublishedPri)' == ''" Text="发布目录缺少 .pri（资源索引），发布版会启动即崩；请检查 CopyXamlArtifactsOnPublish target 是否生效。" />
    <Error Condition="!Exists('$(PublishDir)app.ico')" Text="发布目录缺少 app.ico（AppWindow.SetIcon 需要文件路径），请检查 CopyXamlArtifactsOnPublish target。" />
  </Target>
</Project>
