<Window
    x:Class="PCActivityLog.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="电脑日志记录">

    <Grid x:Name="RootGrid">
        <NavigationView x:Name="Nav"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="200"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="时间线" Tag="timeline" IsSelected="True">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="List"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="统计" Tag="stats">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="FourBars"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
